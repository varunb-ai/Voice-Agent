# ── LLM: Qwen3-32B (open source) via Ollama ──────────
#   Ollama serves an OpenAI-compatible endpoint at /v1.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama          # Ollama ignores the value but the client requires one
LLM_MODEL=qwen3:32b         # for a low-RAM dev box use e.g. qwen3:8b, same family

# ── Database: PostgreSQL ─────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctors

# ── Memory: Redis (Agent 4 current-call memory) ──────
REDIS_URL=redis://localhost:6379/0

# ── Email Agent (Agent 3) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=             # use an app-password, not your real password

# ── SignalWire (real phone calls — $5 free credit, no card needed) ──
#   Sign up: https://signalwire.com
SIGNALWIRE_SPACE=myproject.signalwire.com   # your space URL
SIGNALWIRE_PROJECT_ID=                       # Dashboard -> API -> Project ID
SIGNALWIRE_API_TOKEN=                        # Dashboard -> API -> API Token
SIGNALWIRE_FROM_NUMBER=                      # number you bought

# ── Twilio (real phone calls — $15 free credit, no card needed) ──
#   Sign up: https://twilio.com
TWILIO_ACCOUNT_SID=          # Console -> Account SID
TWILIO_AUTH_TOKEN=           # Console -> Auth Token
TWILIO_FROM_NUMBER=          # your Twilio number e.g. +12015550100
#   Trial restriction: Console -> Verified Caller IDs -> add each hospital number

# ── Telnyx (real phone calls — $10 free credit, no card) ─
#   Sign up: https://telnyx.com
TELNYX_API_KEY=            # Dashboard -> API Keys -> V2 key
TELNYX_FROM_NUMBER=        # your Telnyx number e.g. +12125550100
TELNYX_CONNECTION_ID=      # Dashboard -> Call Control -> App -> Application ID

# ── Public server URL (ngrok tunnel while testing) ────
#   Run:  ngrok http 8000
#   Copy the https URL here
SERVER_PUBLIC_URL=https://your-id.ngrok-free.app

# ── Voice Agent: LiveKit (telephony + agents) — optional ─
LIVEKIT_URL=               # wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Voice models (open source) ───────────────────────
WHISPER_MODEL=small        # faster-whisper size; "small" is good on a CPU
COSYVOICE_MODEL_DIR=       # local folder of the downloaded CosyVoice 2 model

# ── Agent's spoken voice ─────────────────────────────
VOICE_GENDER=female        # "female" (Zira) or "male" (David)
VOICE_AGE=adult            # "young" | "adult" | "senior"  (controls speaking speed)
VOICE_RATE=0               # words/min; 0 = auto from VOICE_AGE, or set e.g. 165
VOICE_VOLUME=1.0           # 0.0 - 1.0

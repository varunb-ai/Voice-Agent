# ═══════════════════════════════════════════════════════════════════════════
#  THE GOLDEN PATH — five values, and nothing below this block is needed.
#
#  This is the system: Twilio places the call, the audio bridges to OpenAI's
#  Realtime API, and the guards decide what reaches the record. See SETUP.md.
# ═══════════════════════════════════════════════════════════════════════════

# ── OpenAI (the agent's speech and reasoning, in one model) ──────────────────
#   platform.openai.com -> API keys. The key MUST have Realtime API access;
#   an ordinary key does not get it automatically. Verify before you spend a
#   phone call on it:  python check_realtime.py
OPENAI_API_KEY=

# ── Twilio (the phone line) ─────────────────────────────────────────────────
#   Sign up: https://twilio.com  — about $15 trial credit, no card needed.
#   A call costs roughly $0.11-0.15/min all-in (OpenAI audio + Twilio minutes).
TWILIO_ACCOUNT_SID=          # Console -> Account SID
TWILIO_AUTH_TOKEN=           # Console -> Auth Token
TWILIO_FROM_NUMBER=          # your Twilio number, e.g. +12015550100
#   TRIAL ACCOUNTS CAN ONLY CALL VERIFIED NUMBERS. Console -> Phone Numbers ->
#   Verified Caller IDs -> add each number you intend to ring, and answer the
#   confirmation call. Without it Twilio fails with 21219 before our code runs.

# ── Public server URL (the tunnel Twilio calls back on) ─────────────────────
#   Twilio has to reach YOUR machine: it posts /answer and then opens a
#   WebSocket to it. Run `ngrok http 8000` in a second window, then let the
#   script fill this in — do not copy it by hand:
#
#       python update_ngrok_url.py
#
#   The URL changes on every tunnel restart, and a stale one fails SILENTLY:
#   the call connects, the webhook goes to a dead host, the callee hears
#   nothing. run_twilio.py refuses to place a call when it detects a stale URL.
SERVER_PUBLIC_URL=https://your-id.ngrok-free.app

# ── Which script the agent runs ─────────────────────────────────────────────
#   forage_data_collection  the branch only                        (default)
#   forage_ai_disclosed     the same, announcing it is automated
#   provider_verification   identity -> branch -> accepting -> scheduling ->
#                           referral, each gated on identity == confirmed
CALL_TEMPLATE=forage_data_collection

# The Realtime path is the default. Set false only for the legacy local
# pipeline at the bottom of this file.
USE_REALTIME=true

# ── Ambient room tone (optional, off) ───────────────────────────────────────
#   Between the agent's turns the person on the other end is sent no frames at
#   all, and mu-law 0xFF is a dead channel rather than a quiet one. Turning
#   this on lays a continuous low-level room tone under the call and ducks it
#   smoothly under the agent's voice.
#
#   OFF IS THE OLD BEHAVIOUR EXACTLY. On, a paced task takes ownership of the
#   outbound wire (Twilio queues media rather than mixing it, so a bed that
#   plays during silence has to be the same samples as the voice) and adds
#   ~40ms to voice onset. Read the module docstring in agents/voice/ambience.py
#   before changing the levels: the codec pins them, the ramps are the part
#   worth tuning. Audition with scripts/render_ambience_demo.py.
REALTIME_AMBIENCE=false
REALTIME_AMBIENCE_PATH=          # empty = data/ambience/room_tone.wav
REALTIME_AMBIENCE_DB=-45         # resting level, dBFS RMS on the wire
REALTIME_AMBIENCE_DUCK_DB=-58    # under the voice; below ~-60 is just muting
REALTIME_AMBIENCE_ATTACK_MS=75   # time to duck when the agent starts speaking
REALTIME_AMBIENCE_RELEASE_MS=300 # time to come back when it stops
REALTIME_AMBIENCE_HOLD_MS=300    # how long it stays down first, so a pause
                                 # inside a sentence does not pump the bed


# ═══════════════════════════════════════════════════════════════════════════
#  EVERYTHING BELOW IS OPTIONAL OR LEGACY.
#
#  Nothing here is on the live path. Leave it all empty for a normal call.
# ═══════════════════════════════════════════════════════════════════════════

# ── Local/offline pipeline (USE_REALTIME=false) ─────────────────────────────
#   VAD -> Whisper -> a local LLM -> Piper, in agents/experiment/. Slower and
#   noticeably worse at conversation; useful only for working offline. Ollama
#   serves an OpenAI-compatible endpoint at /v1.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama          # Ollama ignores the value but the client requires one
LLM_MODEL=qwen3:8b          # the design's qwen3:32b needs a much larger machine
WHISPER_MODEL=small         # faster-whisper size; "small" is good on a CPU

# ── Agent's spoken voice (legacy pipeline only) ─────────────────────────────
#   The Realtime path picks its voice with REALTIME_VOICE, not these.
VOICE_GENDER=female         # "female" (Zira) or "male" (David)
VOICE_AGE=adult             # "young" | "adult" | "senior"  (speaking speed)
VOICE_RATE=0                # words/min; 0 = auto from VOICE_AGE, or e.g. 165
VOICE_VOLUME=1.0            # 0.0 - 1.0

# ── Database — optional ─────────────────────────────────────────────────────
#   Unset, core/db.py falls back to JSON files under data/db/, which is fine
#   for a single machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctors

# ── Redis — optional ────────────────────────────────────────────────────────
#   Unset, call memory is in-process. Only matters across workers.
REDIS_URL=redis://localhost:6379/0

# ── Email agent — optional, a separate path from voice ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=             # use an app-password, not your real password

# ── Retired telephony providers ─────────────────────────────────────────────
#   SignalWire, Telnyx, Vonage and LiveKit were surveyed before the project
#   standardised on Twilio. Their workers now live in
#   archive/experiment_telephony/ and nothing on any live path imports them.
#
#   Their settings are still declared in core/config.py (SIGNALWIRE_*,
#   TELNYX_*, VONAGE_*, LIVEKIT_*) so the archived workers still resolve if
#   they are ever moved back. They are deliberately NOT listed here: this file
#   is what a new person fills in, and four dead providers at the top of it is
#   how the last version of this guide sent people to install LiveKit.
#   See archive/README.md.

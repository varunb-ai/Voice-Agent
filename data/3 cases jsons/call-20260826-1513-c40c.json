  "transcript": [
    {
      "role": "agent",
      "text": "Hi, this is David, calling on behalf of Forage AI to verify some information that was missed on our website \u2014 I'm not calling to book anything. Is now a good time?",
      "timestamp": "15:13:19",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, it's a good time, go ahead.",
      "timestamp": "15:13:30",
      "audio_rms": 0.14214572310447693
    },
    {
      "role": "agent",
      "text": "Thanks \u2014 is this Dr. Reyes, Oncology, at Lakeview Medical?",
      "timestamp": "15:13:32",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, Dr. Riaz Arif is our oncologist.",
      "timestamp": "15:13:42",
      "audio_rms": 0.15224425494670868
    },
    {
      "role": "agent",
      "text": "Thanks \u2014 I heard a different name there, so could you spell the last name you have for the oncologist, one letter at a time, so I can make sure we\u2019re talking about Dr. Reyes?",
      "timestamp": "15:13:46",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes. REYES",
      "timestamp": "15:13:57",
      "audio_rms": 0.13692015409469604
    },
    {
      "role": "agent",
      "text": "Sorry, I need to be sure it\u2019s Dr. Reyes \u2014 is that the exact name you have?",
      "timestamp": "15:14:02",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, that's the exact name I have. waitlist.",
      "timestamp": "15:14:10",
      "audio_rms": 0.12479452788829803
    },
    {
      "role": "agent",
      "text": "Got it \u2014 is it Dr. Reyes, spelled R-E-Y-E-S, the oncologist, and not Dr. Riaz Arif?",
      "timestamp": "15:14:17",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, that's correct.",
      "timestamp": "15:14:27",
      "audio_rms": 0.09587645530700684
    },
    {
      "role": "agent",
      "text": "Thanks \u2014 which branch does Dr. Reyes work out of?",
      "timestamp": "15:14:29",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "She's at the westside campus, 1476 8th Street.",
      "timestamp": "15:14:40",
      "audio_rms": 0.1272605061531067
    },
    {
      "role": "agent",
      "text": "Got it \u2014 is Dr. Reyes currently taking new patients?",
      "timestamp": "15:14:43",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, she is taking on new patients right now.",
      "timestamp": "15:14:51",
      "audio_rms": 0.17060016095638275
    },
    {
      "role": "agent",
      "text": "Good to know \u2014 can a new patient actually get scheduled at the moment?",
      "timestamp": "15:14:54",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, you can book online or you can also directly call us. Anything is set.",
      "timestamp": "15:15:03",
      "audio_rms": 0.17111662030220032
    },
    {
      "role": "agent",
      "text": "Thanks \u2014 is a referral required for new patients, or does it depend on their situation or insurance?",
      "timestamp": "15:15:07",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, only if you have insurance with a particular company then only the referral is required.",
      "timestamp": "15:15:20",
      "audio_rms": 0.13700032234191895
    },
    {
      "role": "agent",
      "text": "Thanks for the details \u2014 have a good one.",
      "timestamp": "15:15:22",
      "audio_rms": null
    }

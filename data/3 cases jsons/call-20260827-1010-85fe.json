  "transcript": [
    {
      "role": "agent",
      "text": "Hi, this is David, calling on behalf of Forage AI to verify some information that was missed on our website \u2014 I'm not calling to book anything. Is now a good time?",
      "timestamp": "10:10:08",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "By David, it's a good time.",
      "timestamp": "10:10:20",
      "audio_rms": 0.11248334497213364
    },
    {
      "role": "agent",
      "text": "Thanks for that \u2014 is this Dr. Jennifer, Cardiology\u2019s office at New York Baptist Hospital?",
      "timestamp": "10:10:22",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, that's correct.",
      "timestamp": "10:10:31",
      "audio_rms": 0.09949340671300888
    },
    {
      "role": "agent",
      "text": "Got it \u2014 which branch does Dr. Jennifer work out of?",
      "timestamp": "10:10:33",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Um Private site campus.",
      "timestamp": "10:10:39",
      "audio_rms": 0.15409378707408905
    },
    {
      "role": "agent",
      "text": "Thanks for that \u2014 I\u2019m just noting Riverside Campus now, then I\u2019ll ask about new patients.",
      "timestamp": "10:10:43",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Okay.",
      "timestamp": "10:10:50",
      "audio_rms": 0.10501179844141006
    },
    {
      "role": "agent",
      "text": "Got it \u2014 is that the full name on the sign, or could you share the street address for Riverside Campus?",
      "timestamp": "10:10:53",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "I think that's the same.",
      "timestamp": "10:11:02",
      "audio_rms": 0.12814109027385712
    },
    {
      "role": "agent",
      "text": "Right, do you have the street address for it, even just the number and street name?",
      "timestamp": "10:11:05",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "No, I don't have it.",
      "timestamp": "10:11:12",
      "audio_rms": 0.12930725514888763
    },
    {
      "role": "agent",
      "text": "Thanks for sticking with me \u2014 I\u2019ll use the name you gave and move on from there.",
      "timestamp": "10:11:15",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Ok.",
      "timestamp": "10:11:24",
      "audio_rms": 0.10235234349966049
    },
    {
      "role": "agent",
      "text": "Thanks for that location \u2014 is Dr. Jennifer currently taking new patients?",
      "timestamp": "10:11:25",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "No.",
      "timestamp": "10:11:32",
      "audio_rms": 0.1843588650226593
    },
    {
      "role": "agent",
      "text": "Thanks for letting me know \u2014 is there a waitlist or any other way to request an appointment?",
      "timestamp": "10:11:35",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "No, I don't know.",
      "timestamp": "10:11:43",
      "audio_rms": 0.1568865329027176
    },
    {
      "role": "agent",
      "text": "No problem \u2014 thanks for your time.",
      "timestamp": "10:11:45",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Thank you.",
      "timestamp": "10:11:53",
      "audio_rms": 0.08148831874132156
    },
    {
      "role": "agent",
      "text": "Take care.",
      "timestamp": "10:11:54",

  "transcript": [
    {
      "role": "agent",
      "text": "Hi, this is David, calling on behalf of Forage AI to verify some information that was missed on our website \u2014 I'm not calling to book anything. Is now a good time?",
      "timestamp": "12:14:20",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Good morning",
      "timestamp": "12:14:32",
      "audio_rms": 0.10838553309440613
    },
    {
      "role": "agent",
      "text": "Good morning \u2014 is this Dr. Jennifer, Cardiology, at New York Baptist Hospital?",
      "timestamp": "12:14:34",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, yes, you're talking with Jennifer Doctor. How can I help you?",
      "timestamp": "12:14:42",
      "audio_rms": 0.1182854101061821
    },
    {
      "role": "agent",
      "text": "Got it, thanks \u2014 which branch do you work out of for New York Baptist Hospital?",
      "timestamp": "12:14:46",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Ah",
      "timestamp": "12:14:52",
      "audio_rms": 0.15117168426513672
    },
    {
      "role": "caller",
      "text": "Actually, I am working at the Northside Medical Group. Can I know who is calling?",
      "timestamp": "12:14:57",
      "audio_rms": 0.1907041072845459
    },
    {
      "role": "agent",
      "text": "This is David, calling on behalf of Forage AI.",
      "timestamp": "12:15:00",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Okay. And what else do you need from me? Command",
      "timestamp": "12:15:08",
      "audio_rms": 0.10724031925201416
    },
    {
      "role": "agent",
      "text": "Got it \u2014 is Northside Medical Group a branch of New York Baptist Hospital, or a separate organization you work for now?",
      "timestamp": "12:15:13",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "It's a bench.",
      "timestamp": "12:15:23",
      "audio_rms": 0.14019480347633362
    },
    {
      "role": "agent",
      "text": "Thanks \u2014 is Dr. Jennifer currently taking new patients?",
      "timestamp": "12:15:25",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, yes.",
      "timestamp": "12:15:31",
      "audio_rms": 0.12368007749319077
    },
    {
      "role": "agent",
      "text": "Nice, thanks \u2014 can a new patient actually get an appointment scheduled right now?",
      "timestamp": "12:15:33",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "But you can get it, please apply before it.",
      "timestamp": "12:15:42",
      "audio_rms": 0.1310824453830719
    },
    {
      "role": "agent",
      "text": "Right, I want to be sure I understood \u2014 for a new patient, can an appointment be booked now?",
      "timestamp": "12:15:46",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yeah, like anytime you can book it now through online.",
      "timestamp": "12:15:57",
      "audio_rms": 0.14352105557918549
    },
    {
      "role": "agent",
      "text": "Okay, let me note that and then ask one more quick thing about referrals.",
      "timestamp": "12:15:59",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Again one more question.",
      "timestamp": "12:16:07",
      "audio_rms": 0.18484601378440857
    },
    {
      "role": "agent",
      "text": "Thanks \u2014 is a referral required for a new patient, or does it depend on the insurance or situation?",
      "timestamp": "12:16:08",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "No, no, for now, no need of it. You can book it as usual.",
      "timestamp": "12:16:20",
      "audio_rms": 0.28029876947402954
    },
    {
      "role": "agent",
      "text": "Thanks for confirming there's no referral needed.",
      "timestamp": "12:16:22",
      "audio_rms": null
    }
  ],

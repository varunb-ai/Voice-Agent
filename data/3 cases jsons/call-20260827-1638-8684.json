  "transcript": [
    {
      "role": "agent",
      "text": "Hi, this is David, calling on behalf of Forage AI to verify some information that was missed on our website \u2014 I'm not calling to book anything. Is now a good time?",
      "timestamp": "16:38:30",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes. It's a good time",
      "timestamp": "16:38:42",
      "audio_rms": 0.13393263518810272
    },
    {
      "role": "agent",
      "text": "Thanks \u2014 is this Dr. Jennifer, Cardiology, at New York Baptist Hospital?",
      "timestamp": "16:38:45",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, Jennifer is one of cardiologist.",
      "timestamp": "16:38:56",
      "audio_rms": 0.18461529910564423
    },
    {
      "role": "agent",
      "text": "Got it \u2014 which branch does Dr. Jennifer work out of?",
      "timestamp": "16:38:58",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "I don't know that.",
      "timestamp": "16:39:05",
      "audio_rms": 0.18159669637680054
    },
    {
      "role": "agent",
      "text": "No problem \u2014 is there someone there who might know which site she sees patients at?",
      "timestamp": "16:39:07",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "I think I need to confirm with someone.",
      "timestamp": "16:39:15",
      "audio_rms": 0.21145544946193695
    },
    {
      "role": "agent",
      "text": "Sure, no rush.",
      "timestamp": "16:39:19",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Are you there?",
      "timestamp": "16:39:28",
      "audio_rms": 0.1613101214170456
    },
    {
      "role": "agent",
      "text": "Yeah, I\u2019m here \u2014 take your time while you check.",
      "timestamp": "16:39:30",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yeah, I got it. She works at Riverside campus.",
      "timestamp": "16:39:40",
      "audio_rms": 0.21675220131874084
    },
    {
      "role": "agent",
      "text": "Thanks for that \u2014 is Dr. Jennifer currently taking new patients?",
      "timestamp": "16:39:42",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, she's taking.",
      "timestamp": "16:39:48",
      "audio_rms": 0.16757425665855408
    },
    {
      "role": "agent",
      "text": "Good to know \u2014 can a new patient actually book an appointment right now?",
      "timestamp": "16:39:51",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "Yes, That can be do it.",
      "timestamp": "16:39:58",
      "audio_rms": 0.21909849345684052
    },
    {
      "role": "agent",
      "text": "Got it \u2014 is a referral required, or does it depend on insurance or the situation?",
      "timestamp": "16:40:03",
      "audio_rms": null
    },
    {
      "role": "caller",
      "text": "It does required and also it may be depend upon the insurance also.",
      "timestamp": "16:40:15",
      "audio_rms": 0.18888495862483978
    },
    {
      "role": "agent",
      "text": "Thanks for the details on the Riverside Campus. Take care.",
      "timestamp": "16:40:18",
